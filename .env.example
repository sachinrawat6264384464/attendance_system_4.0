# ==============================================================================
# SCHOOL MANAGEMENT & ACADEMIC TRACKING PLATFORM
# Environment Configuration (Dedicated Single-Institution / Non-SaaS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
APP_NAME="Om Public School Academic Platform"
FRONTEND_URL=https://attendancesystem40-frontend.vercel.app
BACKEND_URL=https://attendancesystem40-backend.vercel.app

# ------------------------------------------------------------------------------
# 2. NEON POSTGRESQL DATABASE (Mandatory sslmode=require)
# ------------------------------------------------------------------------------
# Pooled connection URL for application runtime queries (Neon PgBouncer / pooler on port 5432 or 6543)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/schooldb?sslmode=require&pgbouncer=true"

# Direct connection URL for Prisma migrations & schema changes (Bypasses pooler for advisory locks & DDL)
DIRECT_URL="postgresql://user:password@ep-xyz.region.neon.tech/schooldb?sslmode=require"

# Database Connection Pool Tuning
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Argon2id + Dual Token JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="replace-with-a-very-long-and-secure-random-secret-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-a-very-long-and-secure-random-secret-for-refresh-tokens"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cookie Configuration for Refresh Tokens
COOKIE_SECRET="replace-with-a-secure-cookie-signature-secret"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. CLOUDINARY FILE STORAGE (Assignment attachments, PDFs, Profile photos)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="school_management_system"
# Maximum upload limits in bytes (e.g., 10MB = 10485760)
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. REDIS & BACKGROUND QUEUES (Upstash Redis or Local Redis for BullMQ)
# ------------------------------------------------------------------------------
# For BullMQ & Redis-backed Rate Limiter
REDIS_URL="redis://localhost:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false

# Upstash REST credentials (if using HTTP-based Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED RATE LIMITING
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5

# ------------------------------------------------------------------------------
# 7. INSTITUTION PROFILE (Dedicated Single-School Settings - Non-SaaS)
# ------------------------------------------------------------------------------
SCHOOL_NAME="Apex Model Senior Secondary School"
SCHOOL_CODE="APEX-SCH-01"
SCHOOL_EMAIL="admin@apexschool.edu"
SCHOOL_PHONE="+91 98765 43210"
SCHOOL_ADDRESS="Knowledge City, Sector 4, Educational Hub"
SCHOOL_AFFILIATION_NO="CBSE-AFF-2024-987"
SCHOOL_CURRENCY="INR"
TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 8. ATTENDANCE POLICY DEFAULTS
# ------------------------------------------------------------------------------
# Minimum period attendance percentage required to be marked present for the day
ATTENDANCE_MIN_PERIODS_FOR_DAY_PRESENT=3
# Allow attendance correction request window in days
ATTENDANCE_CORRECTION_WINDOW_DAYS=7

# ------------------------------------------------------------------------------
# 9. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="Apex Academy"
NEXT_PUBLIC_SCHOOL_NAME="Apex Model Senior Secondary School"
NEXT_PUBLIC_SCHOOL_PHONE="+91 98765 43210"
NEXT_PUBLIC_SCHOOL_EMAIL="info@apexschool.edu"

